{
  "manifest_version": 3,
  "name": "Pick",
  "version": "1.0",
  "description": "Hover any element for Edit / Delete / Move, then copy the changes.",
  "permissions": ["scripting", "activeTab", "storage"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "sw.js", "scripts": ["sw.js"] },
  "browser_specific_settings": { "gecko": { "id": "pick@claude.local", "strict_min_version": "121.0" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_title": "Pick an element",
    "default_icon": { "16": "icon16.png", "32": "icon32.png" }
  },
  "commands": {
    "pick": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Toggle the element picker"
    }
  }
}
